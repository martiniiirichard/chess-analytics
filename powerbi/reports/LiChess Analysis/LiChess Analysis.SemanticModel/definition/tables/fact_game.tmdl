		isHidden
		summarizeBy: none
		sourceColumn: BlackRating_SK

		annotation SummarizationSetBy = Automatic

	column RatingDifferenceBucket_SK
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: RatingDifferenceBucket_SK

		annotation SummarizationSetBy = Automatic

	column TimeControl_SK
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: TimeControl_SK

		annotation SummarizationSetBy = Automatic

	column Termination_SK
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: Termination_SK

		annotation SummarizationSetBy = Automatic

	column ECO_SK
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: ECO_SK

		annotation SummarizationSetBy = Automatic

	column OpeningVariation_SK
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: OpeningVariation_SK

		annotation SummarizationSetBy = Automatic

	column WhiteScore
		dataType: double
		summarizeBy: none
		sourceColumn: WhiteScore

		annotation SummarizationSetBy = Automatic

	column BlackScore
		dataType: double
		summarizeBy: none
		sourceColumn: BlackScore

		annotation SummarizationSetBy = Automatic

	column IsWhiteWin
		dataType: int64
		summarizeBy: none
		sourceColumn: IsWhiteWin

		annotation SummarizationSetBy = Automatic

	column IsBlackWin
		dataType: int64
		summarizeBy: none
		sourceColumn: IsBlackWin

		annotation SummarizationSetBy = Automatic

	column IsDraw
		dataType: int64
		summarizeBy: none
		sourceColumn: IsDraw

		annotation SummarizationSetBy = Automatic

	column PlyCount
		dataType: int64
		summarizeBy: none
		sourceColumn: PlyCount

		annotation SummarizationSetBy = Automatic

	column AbsRatingDifference
		dataType: int64
		summarizeBy: none
		sourceColumn: AbsRatingDifference

		annotation SummarizationSetBy = Automatic

	column IsTimeForfeit
		dataType: int64
		summarizeBy: none
		sourceColumn: IsTimeForfeit

		annotation SummarizationSetBy = Automatic

	column SourceMonth
		dataType: string
		summarizeBy: none
