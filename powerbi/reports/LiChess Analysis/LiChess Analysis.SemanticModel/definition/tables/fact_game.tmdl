	column SilverTransformRunID
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: SilverTransformRunID

		annotation SummarizationSetBy = Automatic

	column GoldTransformRunID
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: GoldTransformRunID

		annotation SummarizationSetBy = Automatic

	column GoldTransformVersion
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: GoldTransformVersion

