table fact_game
	lineageTag: 69600458-ad14-4cea-818d-a76e4abe3f02

	column SourceGameID
		dataType: string
		summarizeBy: none
		sourceColumn: SourceGameID

		annotation SummarizationSetBy = Automatic

	column Date_SK
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: Date_SK

		annotation SummarizationSetBy = Automatic

	column WhiteRating_SK
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: WhiteRating_SK

		annotation SummarizationSetBy = Automatic

	column BlackRating_SK
