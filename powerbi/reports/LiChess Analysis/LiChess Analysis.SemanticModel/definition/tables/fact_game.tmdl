	column SchemaVersion
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: SchemaVersion

		annotation SummarizationSetBy = Automatic

	measure 'Game Count' =
			COUNTROWS ( fact_game )
		formatString: #,##0
		displayFolder: 01. Core Metrics
		lineageTag: c1ca966b-4aed-46c9-85a6-3723f96d499d

	measure 'White Score %' =
			DIVIDE ( SUM ( fact_game[WhiteScore] ), [Game Count] )
		formatString: 0.0%
		displayFolder: 01. Core Metrics
		lineageTag: 680a03c2-f64e-48ee-a77d-98e447a7685d

	measure 'Black Score %' =
			DIVIDE ( SUM ( fact_game[BlackScore] ), [Game Count] )
		formatString: 0.0%
		displayFolder: 01. Core Metrics
		lineageTag: 8c394a91-c672-495f-91c8-c90a1849388b

	measure 'White Win Rate' =
			DIVIDE ( SUM ( fact_game[IsWhiteWin] ), [Game Count] )
		formatString: 0.0%
		displayFolder: 01. Core Metrics
		lineageTag: f2c5d6ec-9ddd-4e3d-81f2-245680d4e89f

	measure 'Black Win Rate' =
			DIVIDE ( SUM ( fact_game[IsBlackWin] ), [Game Count] )
		formatString: 0.0%
		displayFolder: 01. Core Metrics
		lineageTag: ea7f7f2f-a1c9-41a3-94a6-e7bd81a201e4

	measure 'Draw Rate' =
			DIVIDE ( SUM ( fact_game[IsDraw] ), [Game Count] )
		formatString: 0.0%
		displayFolder: 01. Core Metrics
		lineageTag: 84b14e7f-7191-47ae-af27-c0ce08d1e410

	measure 'Time Forfeit Count' =
			CALCULATE ( [Game Count], dim_termination[IsTimeForfeit] = 1 )
		formatString: #,##0
		displayFolder: 02. Termination
		lineageTag: 0f5f9214-74a2-4671-adb2-68cb6c602b41

	measure 'Time Forfeit Rate' =
			DIVIDE ( [Time Forfeit Count], [Game Count] )
		formatString: 0.0%
		displayFolder: 02. Termination
		lineageTag: 90f5bcfc-0b7b-4f9b-99fc-1a60f352baf3

	partition fact_game = m
		mode: import
		source =
				let
				    Source = Folder.Files("C:\\Users\\marti\\OneDrive\\Documents\\New project\\chess-analytics\\data\\gold\\game"),
				    FilteredRows = Table.SelectRows(Source, each [Name] = "fact_game.parquet"),
				    AddedData = Table.AddColumn(FilteredRows, "Data", each Parquet.Document([Content])),
				    Combined = Table.Combine(AddedData[Data])
				in
				    Combined

	annotation PBI_ResultType = Table
